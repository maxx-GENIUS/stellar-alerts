{
  "name": "api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/workers/watcher.worker.ts",
    "dev:indexer": "tsx watch --env-file=.env src/workers/soroban-indexer.worker.ts",
    "indexer:benchmark": "tsx --env-file=.env src/workers/soroban-indexer.worker.ts benchmark",
    "dev:exports": "tsx watch --env-file=.env src/workers/export.worker.ts",
    "dev:supervisor": "tsx --env-file=.env src/workers/supervisor.ts",
    "dev:checksum-worker": "tsx watch --env-file=.env src/workers/checksum-chain.worker.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:integration": "vitest run --run --no-file-parallelism --exclude \"src/**/!(*.integration).test.ts\"",
    "test:unit": "vitest run --run --exclude \"**/*.integration.test.ts\" --exclude \"src/testing/__tests__/**\"",
    "test:fixtures": "vitest run --config vitest.integration.config.ts --run",
    "test:fuzz": "vitest run src/utils/__tests__/webhook-fuzzer.test.ts",
    "test:e2e": "vitest run src/__tests_/e2e.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:webhooks": "vitest -c ./vitest.config.ts apps/api/src/modules/webhooks/__tests__ --run",
    "cli:tui": "tsx --env-file=.env src/cli/tui-dashboard.tsx",
    "daemon:start": "tsx --env-file=.env src/cli/daemon.ts start",
    "daemon:install:systemd": "tsx src/cli/daemon.ts install:systemd",
    "daemon:install:launchd": "tsx src/cli/daemon.ts install:launchd"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/opossum": "^8.1.9",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/snarkjs": "^0.7.9",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "c12": "^3.1.0",
    "fast-check": "^4.10.2",
    "form-data": "^4.0.6",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.3",
    "prisma": "^7.10.1",
    "supertest": "^7.3.0",
    "toxiproxy-node-client": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unpkg": "^0.2.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@opentelemetry/api": "^1.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/instrumentation": "^7.10.1",
    "@stellar-alerts/shared": "*",
    "bullmq": "^6.3.16",
    "commander": "^15.0.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "graphql": "^17.0.2",
    "graphql-subscriptions": "^3.0.0",
    "handlebars": "^4.7.10",
    "ioredis": "^6.0.0",
    "ink": "^5.0.0",
    "ink-table": "^3.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "opossum": "^10.0.0",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pure-rand": "^8.4.2",
    "qrcode": "^1.5.3",
    "react": "^19.0.0",
    "resend": "^6.34.1",
    "snarkjs": "^0.7.6",
    "stellar-sdk": "^13.3.0",
    "zod": "^4.6.7"
  }
}
